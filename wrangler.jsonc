{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workers-ollama",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-10",
  "vpc_services": [{
    "binding": "OLLAMA_VPC",
    "service_id": "ollama-local"
  }],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ollama.k586.jp",
      "custom_domain": true
    }
  ]
}